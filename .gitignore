logs/

# User-owned or unlicensed media
wallpapers/private/
assets/*/private/

# Generated preview and build output
preview/dist/
generated/
build/
__pycache__/
*.py[cod]

# Application data must never be versioned
.mozilla/
.config/discord/
.config/vesktop/sessionData/
.config/spotify/
.ssh/
.gnupg/
.zsh_history
.zcompdump*
