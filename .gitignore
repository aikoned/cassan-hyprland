# Operating-system and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Environment files, credentials, and keys
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials*
secrets*

# User-specific Cassan state
local/*
