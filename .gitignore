# Operating-system and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Environment files, credentials, and keys
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials*
secrets*

# User-specific workspace state
local/*
!local/README.md
state/
backups/
logs/

# User-owned media
wallpapers/private/
assets/*/private/

# Workspace-only visual preview and generated build output
/preview/
/scripts/preview.sh
generated/
build/
__pycache__/
*.py[cod]

# Application data must never be versioned
.mozilla/
.config/discord/
.config/vesktop/sessionData/
.config/spotify/
/spicetify/config-xpui.ini
.ssh/
.gnupg/
.zsh_history
.zcompdump*
